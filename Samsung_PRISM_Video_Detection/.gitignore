# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- IDE / Editors ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- ML artefacts ---
*.pth
*.pt
*.ckpt
*.onnx
*.h5
*.safetensors

# --- Data ---
# Ignore contents of these dirs but keep the directories themselves
# (via .gitkeep) so the layout is preserved when the repo is cloned.
data/raw/*
data/processed/*
data/cache/*
data/metadata/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep
!data/metadata/.gitkeep

# Ignore dataset bytes but keep tracked manifests (README + *.yaml/*.json)
datasets/*
!datasets/README.md
!datasets/*.yaml
!datasets/*.yml
!datasets/*.json

# --- Outputs & logs ---
outputs/**
!outputs/
!outputs/metrics/
!outputs/visualizations/
!outputs/predictions/
!outputs/explainability/
!outputs/**/.gitkeep

logs/*
!logs/.gitkeep

checkpoints/*
!checkpoints/.gitkeep

runs/
wandb/
mlruns/

# --- Cache ---
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# --- Env files ---
.env
.env.local
.env.*.local
